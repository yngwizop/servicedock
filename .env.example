# Admin-Login für das Frontend
ADMIN_PASSWORD=dein-sicheres-passwort-hier

# Datenbank-Zugangsdaten (hier ist die "Wahrheit")
POSTGRES_USER=user
POSTGRES_PASSWORD=dein-db-passwort-hier
POSTGRES_DB=dashboard

# Vollständige Datenbank-URL für das Backend
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# WICHTIG: Dedizierter Verschlüsselungs-Key für sensible Daten (Proxmox Token, etc.)
# PFLICHTFELD - MUSS gesetzt sein!
# Generieren mit: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-secure-encryption-key-here

# JWT Secret Key für Authentifizierung
# Generieren mit: openssl rand -hex 32
# Oder: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# Frontend-URL für CORS (in Production anpassen!)
# Beispiel: https://dashboard.example.com
FRONTEND_URL=http://localhost:3000

# Environment (development oder production)
# In development werden zusätzliche localhost-URLs für CORS erlaubt
ENVIRONMENT=development
