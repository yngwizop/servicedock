# Admin-Login für das Frontend
ADMIN_PASSWORD=dein-passwort-hier

# Datenbank-Zugangsdaten (hier ist die "Wahrheit")
POSTGRES_USER=user
POSTGRES_PASSWORD=dein-db-passwort-hier
POSTGRES_DB=dashboard

# Vollständige Datenbank-URL für das Backend
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Optional: Dedizierter Verschlüsselungs-Key für sensible Daten (Proxmox Token, etc.)
# Wenn nicht gesetzt, wird er vom ADMIN_PASSWORD abgeleitet
# Generieren mit: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=your-secure-encryption-key-here
