# ==========================================================================
# Servicedock — Environment Configuration
# ==========================================================================
# Copy this file to ".env" and adjust the values. Never commit secrets to Git.


# --------------------------------------------------------------------------
# 1. Initial login
# --------------------------------------------------------------------------
# Default credentials on a FRESH install: admin / changeme
# The backend forces a password change on first login (force_change=TRUE).
#
# Optional: set a stronger initial password (min. 8 characters) instead of
# 'changeme'. Only applied when no local user exists yet.
# INITIAL_ADMIN_PASSWORD=

# Optional: restrict Proxmox API hosts to specific networks (CIDR, comma-separated).
# Default (empty): RFC1918 ranges + public IPs allowed; loopback / link-local /
# cloud metadata are always blocked (SSRF protection).
# PROXMOX_HOST_ALLOWLIST=192.168.0.0/16,10.0.0.0/8


# --------------------------------------------------------------------------
# 2. Database
# --------------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=dashboard

# DATABASE_URL is built by docker-compose from the POSTGRES_* values (?sslmode=require).
# Do not set DATABASE_URL directly here — placeholders are not resolved by Docker.


# --------------------------------------------------------------------------
# 3. Encryption key (REQUIRED)
# --------------------------------------------------------------------------
# Fernet key used to encrypt sensitive data (Proxmox token, Spotify secrets, …).
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: Never change this key after the first start — encrypted data
# becomes unreadable. Keep a secure backup of the key.
ENCRYPTION_KEY=your-secure-encryption-key-here


# --------------------------------------------------------------------------
# 4. JWT secret (REQUIRED)
# --------------------------------------------------------------------------
# Secret used to sign access and refresh tokens.
# Generate with: openssl rand -hex 32
#
# Can be rotated; all users will be required to log in again afterwards.
JWT_SECRET_KEY=your-jwt-secret-key-here


# --------------------------------------------------------------------------
# 5. CORS & frontend
# --------------------------------------------------------------------------
# Public frontend URL with HTTPS and without an explicit port (Nginx uses 443).
# In production: REQUIRED, e.g. https://dashboard.example.com
# In development: optional, common localhost variants are auto-allowed.
FRONTEND_URL=https://192.168.178.11

# Environment: development | production (default fail-safe is production).
ENVIRONMENT=development


# --------------------------------------------------------------------------
# 6. Token lifetimes
# --------------------------------------------------------------------------
# Access token lifetime in minutes. Short = better security; refresh tokens
# are used automatically when the access token expires.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days. After expiry users must log in again.
REFRESH_TOKEN_EXPIRE_DAYS=1


# --------------------------------------------------------------------------
# 7. Reverse proxy
# --------------------------------------------------------------------------
# Only set TRUST_FORWARDED_HEADERS=true when a trusted reverse proxy
# (Nginx, Traefik, …) sits in front of the backend.
TRUST_FORWARDED_HEADERS=false

# Optional: comma-separated list of trusted proxy IPs (only used when
# TRUST_FORWARDED_HEADERS=true).
# TRUSTED_PROXIES=10.0.0.1,172.18.0.1


# --------------------------------------------------------------------------
# 8. Login rate limiting (optional)
# --------------------------------------------------------------------------
# Failed-login tracker that locks an IP after too many attempts.
# MAX_FAILED_LOGIN_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15


# --------------------------------------------------------------------------
# 9. Redis (optional, recommended)
# --------------------------------------------------------------------------
# Used for rate limiting, failed-login tracking and OAuth state with TTL.
# Default in docker-compose: redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0


# --------------------------------------------------------------------------
# 10. Database driver (optional)
# --------------------------------------------------------------------------
# Experimental psycopg3 connection pool instead of psycopg2.
# USE_PSYCOPG3=true


# --------------------------------------------------------------------------
# 11. Frontend backend URL (optional, Vite)
# --------------------------------------------------------------------------
# Vite prefers VITE_BACKEND_URL. If unset, the frontend uses same-origin
# (works behind an Nginx reverse proxy).
# VITE_BACKEND_URL=https://dashboard.example.com


# --------------------------------------------------------------------------
# Example production .env
# --------------------------------------------------------------------------
# POSTGRES_USER=servicedock
# POSTGRES_PASSWORD=Prod!DB#Password789
# POSTGRES_DB=servicedock
# ENCRYPTION_KEY=<fernet key from python>
# JWT_SECRET_KEY=<openssl rand -hex 32>
# FRONTEND_URL=https://dashboard.example.com
# ENVIRONMENT=production
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
