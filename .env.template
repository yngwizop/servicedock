# ========================================
# Web Dashboard - Environment Configuration
# ========================================
# WICHTIG: Kopiere diese Datei zu ".env" und passe die Werte an!
# Niemals Secrets in Git committen!

# ========================================
# 1. ADMIN-ZUGANGSDATEN
# ========================================
# Passwort für Admin-Login (wird gehasht gespeichert)
# WICHTIG: Starkes Passwort verwenden!
ADMIN_PASSWORD=MeinSicheresPasswort123!

# ========================================
# 2. DATENBANK
# ========================================
POSTGRES_USER=dashboard_user
POSTGRES_PASSWORD=DeinSicheresDBPasswort456!
POSTGRES_DB=dashboard

# Vollständige DB-URL (wird automatisch aus obigen Werten generiert)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ========================================
# 3. VERSCHLÜSSELUNG (PFLICHTFELD!)
# ========================================
# Key für Verschlüsselung sensibler Daten (z.B. Proxmox-Tokens)
# GENERIEREN MIT:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️ WICHTIG: Dieser Key darf NIEMALS geändert werden, sonst sind
#             verschlüsselte Daten nicht mehr lesbar!
# ⚠️ Backup dieses Keys sicher aufbewahren!
ENCRYPTION_KEY=

# ========================================
# 4. JWT-AUTHENTIFIZIERUNG (PFLICHTFELD!)
# ========================================
# Secret Key für JWT-Token-Generierung
# GENERIEREN MIT:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# ODER:
# openssl rand -hex 32
#
# ℹ️ Kann bei Bedarf rotiert werden (alle User müssen sich neu einloggen)
JWT_SECRET_KEY=

# ========================================
# 5. CORS & FRONTEND
# ========================================
# URL des Frontends (für CORS-Konfiguration)
# Development: http://localhost:3000
# Production: https://dashboard.deine-domain.de
FRONTEND_URL=http://localhost:3000

# Environment-Modus
# "development" = Erlaubt zusätzliche localhost-URLs für CORS
# "production"  = Nur FRONTEND_URL erlaubt (sicherer!)
ENVIRONMENT=development

# ========================================
# 6. BEISPIEL FÜR PRODUCTION
# ========================================
# So könnte eine Production-.env aussehen:
#
# ADMIN_PASSWORD=SuperSicheres!Passwort#2024
# POSTGRES_USER=prod_dashboard
# POSTGRES_PASSWORD=Prod!DB#Password789
# POSTGRES_DB=dashboard_prod
# DATABASE_URL=postgresql://prod_dashboard:Prod!DB#Password789@db:5432/dashboard_prod
# ENCRYPTION_KEY=xJ8k_Fernet_Key_generiert_mit_Python
# JWT_SECRET_KEY=a1b2c3d4e5f6...64_zeichen_hex_string
# FRONTEND_URL=https://dashboard.example.com
# ENVIRONMENT=production
