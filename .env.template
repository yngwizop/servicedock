# ========================================
# ServiceDock - Environment Configuration
# ========================================
# WICHTIG: Kopiere diese Datei zu ".env" und passe die Werte an!
# Niemals Secrets in Git committen!

# ========================================
# 1. ADMIN-ZUGANGSDATEN (OPTIONAL)
# ========================================
# ⚠️ DEPRECATED — Das Admin-Passwort wird jetzt in der Datenbank gespeichert!
# Beim ersten Start ist das Default-Passwort: "changeme"
# Nach dem ersten Login MUSS es über die UI geändert werden.
#
# Falls hier ein Passwort gesetzt ist, wird es einmalig beim Start
# in die DB migriert und überschreibt das Default-Passwort.
# Danach kann diese Zeile entfernt werden.
# ADMIN_PASSWORD=

# ========================================
# 2. DATENBANK
# ========================================
# Datenbank-Zugangsdaten (hier ist die "Wahrheit")
POSTGRES_USER=user
POSTGRES_PASSWORD=dein-db-passwort-hier
POSTGRES_DB=dashboard

# Vollständige Datenbank-URL für das Backend
# WICHTIG: ?sslmode=require für SSL-Verbindung
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=require

# ========================================
# 3. VERSCHLÜSSELUNG (PFLICHTFELD!)
# ========================================
# WICHTIG: Dedizierter Verschlüsselungs-Key für sensible Daten (Proxmox Token, etc.)
# PFLICHTFELD - MUSS gesetzt sein!
# Generieren mit: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️ WICHTIG: Dieser Key darf NIEMALS geändert werden, sonst sind
#             verschlüsselte Daten nicht mehr lesbar!
# ⚠️ Backup dieses Keys sicher aufbewahren!
ENCRYPTION_KEY=your-secure-encryption-key-here

# ========================================
# 4. JWT-AUTHENTIFIZIERUNG (PFLICHTFELD!)
# ========================================
# JWT Secret Key für Authentifizierung
# PFLICHTFELD - MUSS gesetzt sein!
# Generieren mit: openssl rand -hex 32
# Oder: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# ℹ️ Kann bei Bedarf rotiert werden (alle User müssen sich neu einloggen)
JWT_SECRET_KEY=your-jwt-secret-key-here

# ========================================
# 5. CORS & FRONTEND
# ========================================
# Frontend-URL für CORS
# WICHTIG: Mit HTTPS und OHNE Port (da Nginx Standard-Port 443 nutzt)
# In Production: PFLICHTFELD! Beispiel: https://dashboard.example.com
# In Development: Optional, localhost-Varianten werden automatisch erlaubt
FRONTEND_URL=https://192.168.178.11

# Environment (development oder production)
# WICHTIG: Default ist "production" (Fail-Safe!)
# In development werden zusätzliche localhost-URLs für CORS erlaubt
ENVIRONMENT=development

# ========================================
# 6. JWT TOKEN CONFIGURATION
# ========================================
# Access Token Laufzeit in Minuten (Default: 15 Minuten)
# Kurze Laufzeit = bessere Security! Bei Ablauf wird automatisch Refresh Token verwendet
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token Laufzeit in Tagen (Default: 1 Tage)
# Ermöglicht "Stay logged in" ohne ständiges Re-Login
# Nach Ablauf muss User sich neu einloggen
REFRESH_TOKEN_EXPIRE_DAYS=1

# ========================================
# 7. REVERSE PROXY SETTINGS
# ========================================
# X-Forwarded-For Trust (nur bei Reverse Proxy!)
# Nur auf "true" setzen wenn Nginx/Traefik vorgeschaltet ist
# Default: false (sicher)
TRUST_FORWARDED_HEADERS=false

# Trusted Proxies (optional, nur wenn TRUST_FORWARDED_HEADERS=true)
# Komma-separierte Liste von vertrauenswürdigen Proxy-IPs
# Beispiel: TRUSTED_PROXIES=10.0.0.1,172.18.0.1
# TRUSTED_PROXIES=

# ========================================
# 8. LOGIN RATE-LIMITING
# ========================================
# Dual-Layer-Schutz gegen Brute-Force-Angriffe:
# Layer 1: slowapi Limiter (5 Requests/Minute) - blockt schnelle Angriffe
# Layer 2: Custom Failed-Login-Tracker - blockt langsame Angriffe

# Maximale Anzahl fehlgeschlagener Login-Versuche bevor IP gesperrt wird
# Default: 5
# MAX_FAILED_LOGIN_ATTEMPTS=5

# Dauer der IP-Sperre nach zu vielen Fehlversuchen (in Minuten)
# Default: 15
# LOGIN_LOCKOUT_MINUTES=15

# ========================================
# 9. BEISPIEL FÜR PRODUCTION
# ========================================
# So könnte eine Production-.env aussehen:
#
# ADMIN_PASSWORD=SuperSicheres!Passwort#2024
# POSTGRES_USER=servicedock
# POSTGRES_PASSWORD=Prod!DB#Password789
# POSTGRES_DB=servicedock
# DATABASE_URL=postgresql://servicedock:Prod!DB#Password789@db:5432/servicedock?sslmode=require
# ENCRYPTION_KEY=xJ8k_Fernet_Key_generiert_mit_Python
# JWT_SECRET_KEY=a1b2c3d4e5f6...64_zeichen_hex_string
# FRONTEND_URL=https://dashboard.example.com
# ENVIRONMENT=production
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
